# Docker Compose 项目标识
COMPOSE_PROJECT_NAME=lingzhi-ai
TZ=Asia/Shanghai

# 仅监听服务器本机，由 Nginx/Caddy 反向代理到公网
AI_SAAS_PORT=3000
NEW_API_PORT=3001

# New API 官方镜像。正式生产可改成已验证的固定版本标签
NEW_API_IMAGE=calciumion/new-api:latest
NEW_API_STREAMING_TIMEOUT=300

# PostgreSQL
POSTGRES_USER=newapi
POSTGRES_DB=newapi
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# New API 会话与缓存签名密钥
NEW_API_SESSION_SECRET=CHANGE_ME_NEW_API_SESSION_SECRET
NEW_API_CRYPTO_SECRET=CHANGE_ME_NEW_API_CRYPTO_SECRET

# AI SaaS 账户签名、灵感商品后台管理与本地持久化
SAAS_SESSION_SECRET=CHANGE_ME_SAAS_SESSION_SECRET
SAAS_ADMIN_KEY=CHANGE_ME_SAAS_ADMIN_KEY
SAAS_DATABASE_PATH=/app/data/commerce.sqlite
SAAS_NEW_USER_BALANCE_CENTS=12860
SAAS_COOKIE_SECURE=false

# 首次启动并在 New API 后台创建令牌后填写，然后重启 ai-saas
NEW_API_ADMIN_TOKEN=

# 仅供不使用 Docker 的本地前端开发；Compose 会覆盖为容器内地址
NEW_API_BASE_URL=

# 配置 HTTPS 后改为 true，并填写 New API 后台的精确 HTTPS Origin
NEW_API_SESSION_COOKIE_SECURE=false
NEW_API_SESSION_COOKIE_TRUSTED_URL=
